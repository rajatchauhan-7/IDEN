{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/app",      "dest": "/app.html" },
    { "src": "/privacy",  "dest": "/privacy.html" },
    { "src": "/terms",    "dest": "/terms.html" },
    { "src": "/(.*)",     "dest": "/index.html" }
  ]
}
