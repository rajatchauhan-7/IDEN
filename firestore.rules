rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) && 
             data.keys().size() == 2 &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.createdAt is number && data.createdAt > 0;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming());
                       
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'createdAt']);
                       
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
